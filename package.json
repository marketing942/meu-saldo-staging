    "@tanstack/react-query": "5.104.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.51.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.89.0",
    "react-router": "7.18.4",
    "zod": "4.6.5",
