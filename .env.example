# Copie para .env.local e preencha. NUNCA coloque aqui a chave service_role.
# Valores em: Supabase > Project Settings > API (use o projeto de STAGING no desenvolvimento).

# URL do projeto Supabase (ex.: https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" (ou "publishable") do projeto. É segura no front: o RLS protege os dados.
VITE_SUPABASE_ANON_KEY=

# local | staging | producao
# Fora de produção aparece "Carregar/Limpar dados de exemplo" em Configurações.
VITE_APP_AMBIENTE=local

# Opcional: DSN do Sentry para monitorar erros. Deixe vazio para desligar.
VITE_SENTRY_DSN=
